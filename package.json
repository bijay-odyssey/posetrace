{
  "name": "posetrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Installable PWA that overlays a live pose 'trace' on the camera and scores how well you match a reference pose.",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "postinstall": "node scripts/prepare.mjs || exit 0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "comlink": "^4.4.2",
    "idb-keyval": "^6.2.1",
    "preact": "^10.24.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
